{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "Compilar Mercado",
      "command": "gcc",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "main.c",
        "produto.c",
        "-o",
        "mercado.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compila todos os arquivos do sistema de estoque."
    }
  ],
  "version": "2.0.0"
}
